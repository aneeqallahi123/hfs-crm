# Database (Railway provides DATABASE_URL automatically on Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=replace_with_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO (local mini PC, exposed via Cloudflare Tunnel)
MINIO_ENDPOINT=your-tunnel-subdomain.trycloudflare.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=hfc-documents

# Webhook shared secret (n8n uses this header: X-Webhook-Secret)
WEBHOOK_SECRET=replace_with_random_string

# WhatsApp / n8n automation
# URL of the n8n webhook that forwards messages to Evolution API (send workflow)
N8N_SEND_WEBHOOK_URL=https://your-n8n.example.com/webhook/hfs-send-wa-message
# Evolution API base URL and credentials (used by n8n; not called directly by the CRM)
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=hfs
# Max size (MB) for inbound WhatsApp files; larger files are rejected with 413.
# Reachable because Evolution API writes the bytes to MinIO locally — see S3_* note below.
MAX_INBOX_FILE_MB=200
# Max size (MB) for the legacy base64 webhook payload. Kept low on purpose: that path carries
# the bytes through n8n (16MB default payload cap) and Railway, so it is for small files only.
MAX_INBOX_BASE64_MB=15

# --- Evolution API S3/MinIO integration (set on the Mini PC, NOT on Railway) ---
# Evolution writes received WhatsApp media straight to MinIO over localhost, so large files
# never cross n8n, Railway, or the Cloudflare Tunnel (100MB request-body cap on the Free plan).
# Also switch "Webhook Base64" OFF in the Evolution manager UI (Events -> Webhook).
#   S3_ENABLED=true
#   S3_ENDPOINT=host.docker.internal
#   S3_PORT=9000
#   S3_USE_SSL=false
#   S3_BUCKET=hfc-documents        # same value as MINIO_BUCKET
#   S3_ACCESS_KEY=<same as MINIO_ACCESS_KEY>
#   S3_SECRET_KEY=<same as MINIO_SECRET_KEY>
#   S3_REGION=us-east-1

# CORS — the deployed frontend URL
CORS_ORIGIN=https://hfc-crm.pages.dev

# Server
PORT=3000
NODE_ENV=production
