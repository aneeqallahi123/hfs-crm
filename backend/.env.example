# Database (Railway provides DATABASE_URL automatically on Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=replace_with_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO (local mini PC, exposed via Cloudflare Tunnel)
MINIO_ENDPOINT=your-tunnel-subdomain.trycloudflare.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=hfc-documents

# Webhook shared secret (n8n uses this header: X-Webhook-Secret)
WEBHOOK_SECRET=replace_with_random_string

# CORS — the deployed frontend URL
CORS_ORIGIN=https://hfc-crm.pages.dev

# Server
PORT=3000
NODE_ENV=production
